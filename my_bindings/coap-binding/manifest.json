{
    "id": "coap-binding",
    "name": "CoAP Binding",
    "version": "1.0.0",
    "description": "Dynamically loaded CoAP server binding based on an available CoAP protocol stack.",
    "entrypoint": "./index.js",
    "provides": {
        "schemes": ["coap"],
        "roles": ["server"],
        "interactions": ["readThingDescription", "readProperty", "writeProperty", "invokeAction"]
    },
    "requires": [
        {
            "type": "protocol-stack",
            "protocol": "coap",
            "direction": "server"
        }
    ]
}
