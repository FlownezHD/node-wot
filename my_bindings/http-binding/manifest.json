{
    "id": "http-binding",
    "name": "HTTP Binding",
    "version": "1.0.0",
    "description": "Dynamically loaded HTTP server binding based on an available HTTP protocol stack.",
    "entrypoint": "./index.js",
    "provides": {
        "schemes": ["http"],
        "roles": ["server"],
        "interactions": ["readThingDescription", "readProperty", "writeProperty", "invokeAction"]
    },
    "requires": {
        "interfaces": [
            {
                "type": "protocol-stack",
                "protocol": "http",
                "direction": "server"
            }
        ],
        "resources": {
            "ports": [
                {
                    "transport": "tcp",
                    "preferred": 8091,
                    "required": true,
                    "exclusive": true
                }
            ]
        }
    }
}
