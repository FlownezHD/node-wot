{
    "id": "new-tcp-binding",
    "name": "New TCP Binding",
    "version": "1.0.0",
    "description": "Minimal dynamically loaded binding using a custom raw TCP protocol over stream sockets.",
    "entrypoint": "./index.js",
    "provides": {
        "schemes": ["new"],
        "roles": ["client", "server"],
        "interactions": ["readThingDescription", "readProperty", "writeProperty", "invokeAction"]
    },
    "requires": [
        {
            "type": "stream-socket",
            "direction": "server",
            "operations": ["listen", "accept", "send", "receive", "close"]
        },
        {
            "type": "stream-socket",
            "direction": "client",
            "operations": ["connect", "send", "receive", "close"]
        }
    ]
}
