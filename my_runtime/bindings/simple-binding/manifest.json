{
    "id": "simple-binding",
    "name": "Simple Binding",
    "version": "1.0.0",
    "description": "A simple custom protocol binding for testing dynamic binding loading.",
    "entrypoint": "./index.js",
    "provides": {
        "schemes": ["simple"],
        "roles": ["client", "server"],
        "interactions": ["readThingDescription", "readProperty", "writeProperty", "invokeAction"]
    },
    "requires": {
        "downwardInterfaces": [
            {
                "type": "request-response-endpoint",
                "transport": "tcp",
                "direction": "server",
                "interfaceProfile": "nodejs-native",
                "resources": {
                    "preferredPort": 8091,
                    "requiredPort": true,
                    "exclusive": true
                }
            },
            {
                "type": "request-response-endpoint",
                "transport": "tcp",
                "direction": "client",
                "interfaceProfile": "nodejs-native"
            }
        ]
    }
}
