{
    "id": "simple-binding",
    "name": "Simple Binding",
    "version": "1.0.0",
    "description": "A simple custom protocol binding for testing dynamic binding loading.",
    "entrypoint": "./index.js",
    "provides": {
        "schemes": ["simple"],
        "roles": ["client", "server"],
        "interactions": ["readThingDescription", "readProperty", "writeProperty", "invokeAction"]
    },
    "requires": {
        "interfaces": [
            {
                "type": "request-response-endpoint",
                "direction": "server",
                "transport": "tcp",
                "profile": "nodejs-native"
            },
            {
                "type": "request-response-endpoint",
                "direction": "client",
                "transport": "tcp",
                "profile": "nodejs-native"
            }
        ],
        "resources": {
            "ports": [
                {
                    "transport": "tcp",
                    "preferred": 8091,
                    "required": true,
                    "exclusive": true
                }
            ]
        }
    }
}
