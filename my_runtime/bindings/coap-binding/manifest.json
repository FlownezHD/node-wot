{
    "id": "coap-binding",
    "name": "CoAP Binding",
    "version": "1.0.0",
    "description": "Dynamically loaded CoAP server binding based on an available CoAP protocol stack.",
    "entrypoint": "./index.js",
    "provides": {
        "schemes": ["coap"],
        "roles": ["server"],
        "interactions": ["readThingDescription", "readProperty", "writeProperty", "invokeAction"]
    },
    "requires": {
        "interfaces": [
            {
                "type": "protocol-stack",
                "protocol": "coap",
                "direction": "server",
                "transport": "udp"
            }
        ],
        "resources": {
            "ports": [
                {
                    "transport": "udp",
                    "preferred": 5684,
                    "required": true,
                    "exclusive": true
                }
            ]
        }
    }
}
