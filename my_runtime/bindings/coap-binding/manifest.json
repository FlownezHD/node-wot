{
    "id": "coap-binding",
    "name": "CoAP Binding",
    "version": "1.0.0",
    "description": "Dynamically loaded CoAP server binding based on the available Node-WoT CoAP stack.",
    "entrypoint": "./index.js",
    "provides": {
        "schemes": ["coap"],
        "roles": ["server"],
        "interactions": ["readThingDescription", "readProperty", "writeProperty", "invokeAction"]
    },
    "requires": {
        "downwardInterfaces": [
            {
                "type": "protocol-stack",
                "protocol": "coap",
                "transport": "udp",
                "direction": "server",
                "interfaceProfile": "library-backed",
                "resources": {
                    "preferredPort": 5684,
                    "requiredPort": true,
                    "exclusive": true
                }
            }
        ]
    }
}
